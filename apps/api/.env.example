# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database — PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/khetly_dev"

# JWT — change both secrets in production (min 32 chars)
JWT_SECRET=khetly-dev-secret-change-in-production-32chars
JWT_REFRESH_SECRET=khetly-refresh-secret-change-in-production-32c
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# SMS Provider: dev | msg91 | fast2sms
SMS_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_SENDER_ID=KHETLY
FAST2SMS_API_KEY=

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Anthropic AI (Phase 2)
ANTHROPIC_API_KEY=
