{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "clean": "rm -rf dist .turbo",
    "prisma": "prisma"
  },
  "dependencies": {
    "@khetly/types": "workspace:*",
    "@khetly/utils": "workspace:*",
    "@prisma/client": "^5.15.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "jsonwebtoken": "^9.0.2",
    "firebase-admin": "^12.1.1",
    "zod": "^3.23.8",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@types/node": "^20.14.2",
    "typescript": "^5.4.5",
    "tsx": "^4.15.1",
    "prisma": "^5.15.0"
  }
}
